# Optional: only needed for the DeepSeek Agent. Leave empty for local analysis.
# Copy this file to .env, fill the key locally, then run pnpm dev:env.
# For a production preview, run pnpm build followed by pnpm preview:env.
# The key is read by Node only. Never rename it to VITE_DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=

# Browser tests use process environment variables, not this file by default.
# PowerShell example: $env:BROWSER_CHANNEL='chrome'; pnpm test:browser
# BROWSER_CHANNEL=chrome
# HUMAN_VIDEO_PATH=C:/local-only/authorized-human-video.mp4

# Optional real-model test settings; set in the shell before running tests.
# OLLAMA_MODEL=your-installed-tools-model
# REAL_AGENT_PROVIDER=deepseek
# REAL_AGENT_FLOW=multi_turn_delivery
# REAL_AGENT_SESSIONS=3
