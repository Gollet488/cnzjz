# Copy to .env in the project root. Restart pnpm dev / pnpm preview after edits.
# Keys are read by Node only. Never prefix them with VITE_.
# *_MODELS is a comma-separated list of tool-capable model IDs enabled for your account.
# When *_MODELS is empty, the provider's first preset is used.
# Example tool models: gpt-6.1-sol, glm-5.3, kimi-k3.1-pro. Availability depends on the API account.
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=
OPENAI_API_KEY=
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
ZHIPU_API_KEY=
ZHIPU_MODELS=
MOONSHOT_API_KEY=
MOONSHOT_MODELS=

# Optional exact official API endpoints (Node only).
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# OPENAI_ENDPOINT=https://api.openai.com/v1/responses
# ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
# ZHIPU_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
# ZHIPU_ENDPOINT=https://api.z.ai/api/paas/v4/chat/completions
# MOONSHOT_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
# MOONSHOT_ENDPOINT=https://api.moonshot.ai/v1/chat/completions

# Browser test settings are set in the launching shell.
# BROWSER_CHANNEL=chrome
# HUMAN_VIDEO_PATH=C:/local-only/authorized-human-video.mp4
# OLLAMA_MODEL=your-installed-tools-model
# REAL_AGENT_PROVIDER=deepseek
# REAL_AGENT_MODEL=deepseek-flash
# REAL_AGENT_FLOW=multi_turn_delivery
# REAL_AGENT_SESSIONS=1
